#--------------------------------------------------------------------
# Minha Lista VIP - ambiente de PRODUÇÃO (Hostinger Web Hosting / PHP)
#
# COMO USAR: no servidor, copie este arquivo para ".env" na RAIZ do
# projeto (o .env não vai para o Git) e preencha os valores marcados.
# --------------------------------------------------------------------
# NO SERVIDOR, o projeto NÃO é o Node.js: é PHP + MySQL (CodeIgniter 4).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# URL pública, com https e barra no final.
# Se deixar COMENTADO, o sistema detecta o domínio automaticamente
# (útil quando você ainda não sabe a URL). Para fixar, descomente:
# app.baseURL = 'https://SEU-DOMINIO.com.br/'
app.indexPage = ''
app.appTimezone = 'America/Sao_Paulo'

# Força HTTPS e envia os cookies de sessão/CSRF apenas em conexões seguras.
# ATENÇÃO: ative isto SOMENTE depois de emitir o certificado SSL no hPanel,
# senão login/site entram em loop de redirecionamento. Se o proxy da Hostinger
# não repassar o HTTPS, mantenha 'false' até o SSL estar funcionando.
app.forceGlobalSecureRequests = true
cookie.secure = true

#--------------------------------------------------------------------
# BANCO DE DADOS (hPanel > Databases > MySQL Databases)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = u776139543_minhalistav
database.default.username = u776139543_SEU_USUARIO
database.default.password = 'SUA-SENHA-DO-BANCO'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.DBDebug = false

#--------------------------------------------------------------------
# CRIPTOGRAFIA
# Gere a chave com: php spark key:generate   (ou preencha manualmente)
#--------------------------------------------------------------------
# encryption.key =

#--------------------------------------------------------------------
# E-MAIL (redefinição de senha, avisos)
# Na Hostinger use o SMTP do próprio domínio (hPanel > E-mails).
# Se deixar comentado, o sistema usa o mail() nativo do PHP.
#--------------------------------------------------------------------
# email.protocol = smtp
# email.SMTPHost = smtp.hostinger.com
# email.SMTPUser = no-reply@SEU-DOMINIO.com.br
# email.SMTPPass = 'SUA-SENHA-DO-EMAIL'
# email.SMTPPort = 465
# email.SMTPCrypto = ssl
# email.fromEmail = no-reply@SEU-DOMINIO.com.br
# email.fromName = 'Minha Lista VIP'

#--------------------------------------------------------------------
# GOOGLE LOGIN (OAuth 2.0 / OpenID Connect) - opcional
# Crie em https://console.cloud.google.com > APIs e serviços > Credenciais.
# Cadastre em "URIs de redirecionamento autorizados":
#   https://SEU-DOMINIO.com.br/auth/google/callback
#--------------------------------------------------------------------
# google.clientId = 1234567890-xxxxxxxx.apps.googleusercontent.com
# google.clientSecret = GOCSPX-xxxxxxxxxxxxxxxx
